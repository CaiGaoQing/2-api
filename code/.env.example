# Kiro API 服务端口
PORT=13003

# MySQL 数据库配置
# 使用内置 MySQL 时，MYSQL_HOST 设为 mysql（docker-compose 服务名）
# 使用外部数据库时，设为外部数据库地址
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=kiro123456
MYSQL_DATABASE=kiro_api

# MySQL 外部访问端口（仅内置 MySQL 时有效）
MYSQL_EXTERNAL_PORT=13306

# SMTP 邮件配置（兑换码邮件通知，可选）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Kiro API
